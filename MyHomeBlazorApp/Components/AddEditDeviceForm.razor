@using MyHomeBlazorApp.BlazorData
@using MyHome.Models
@using MyHome
@using MyHomeBlazorApp.Components.Modals
@using MyHomeBlazorApp.Pages
@using MyHomeBlazorApp.Shared
@using MyHomeBlazorApp.Components

@inject BlazorData.DataService DataService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<style>
    .btn-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-select {
        max-width: auto;
        padding-left: 10px;
        padding-right: 0;
    }

    .left-buttons button,
    .right-buttons button {
        margin: 0 5px;
    }

    .form-group {
        margin-bottom: 10px;
    }
</style>

@if (showErrorMessageVisible)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (CurrentDevice != null)
{
    <EditForm @ref="refAddEditDeviceTest" EditContext="@editContext" id="refAddEditDeviceTest" OnSubmit="Save">
        <DataAnnotationsValidator />

        <div class="form-group row">
            <label for="deviceName" class="col-sm-4 col-form-label">Name</label>
            <div class="col-sm-8">
                <InputText id="deviceName" @bind-Value="CurrentDevice.DeviceName" placeholder="Device Name" class="form-control" />
            </div>
            <ValidationMessage For="@(() => CurrentDevice.DeviceName)" />
        </div>

        <div class="form-group row">
            <label for="deviceProduser" class="col-sm-4 col-form-label">Producer</label>
            <div class="col-sm-8">
                <InputText id="deviceProduser" @bind-Value="CurrentDevice.DeviceProduser" placeholder="Device Producer" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label for="deviceType" class="col-sm-4 col-form-label">Type</label>
            <div class="col-sm-8">
                <InputSelect id="deviceType" @bind-Value="CurrentDevice.DeviceType" class="form-select">
                    @foreach (var type in _deviceTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="form-group row">
            <label for="deviceSerialNumber" class="col-sm-4 col-form-label">Serial Number</label>
            <div class="col-sm-8">
                <InputText id="deviceSerialNumber" @bind-Value="CurrentDevice.DeviceSerialNumber" placeholder="Device Serial Number" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label for="deviceModelNumber" class="col-sm-4 col-form-label">Model Number</label>
            <div class="col-sm-8">
                <InputText id="deviceModelNumber" @bind-Value="CurrentDevice.DeviceModelNumber" placeholder="Device Model Number" class="form-control" />
            </div>
        </div>

        <AuthorizeView Context="auth">
            <Authorized>
                <div class="form-group row">
                    <label for="deviceIpAddress" class="col-sm-4 col-form-label">IP Address</label>
                    <div class="col-sm-8">
                        <InputText id="deviceIpAddress" @bind-Value="CurrentDevice.IpAddress" placeholder="Device IP Address" class="form-control" />
                    </div>
                </div>
                <div class="form-group row">
                    <label for="deviceMacAddress" class="col-sm-4 col-form-label">MAC Address</label>
                    <div class="col-sm-8">
                        <InputText id="deviceMacAddress" @bind-Value="CurrentDevice.MacAdrress" placeholder="MAC Address" class="form-control" />
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="form-group row">
            <label for="deviceManualBookLink" class="col-sm-4 col-form-label">Manual Link</label>
            <div class="col-sm-8 align-content-center">
                <Button class="btn-sm btn btn-outline-info" @onclick="() => DataService.Navigate(CurrentDevice, JSRuntime)">Manual</Button>
            </div>
        </div>

        <div class="row mt-3">
            <div class="form-group">
                @if (CurrentUser != null)
                {
                    <label class="form-label">Select Real Estate:</label>
                    <InputSelect @bind-Value="RealEstateIdToAddDevice" class="form-select" @bind-Value:after="RealEstateIdToAddDeviceChanged">
                        @if (CurrentUser.RealEstates == null || !CurrentUser.RealEstates.Any())
                        {
                            <option value="0">No Real Estates found (Save as Unassigned)</option>
                        }
                        else
                        {
                            <option selected value="0">Select Real Estate...or Will Be Saved As Unassigned</option>
                            @foreach (var realEstate in CurrentUser.RealEstates)
                            {
                                <option value="@realEstate.RealEstateID">@realEstate.RealEstateName || @realEstate.RealEstateID</option>
                            }
                        }
                    </InputSelect>

                    @if (CurrentUser.RealEstates == null || !CurrentUser.RealEstates.Any())
                    {
                        <small class="text-muted d-block mt-1">
                            Tip: You can move this to a Real Estate later.
                        </small>
                    }
                }
            </div>
        </div>
        <br />

        @if (_isGuest)
        {
            <div class="alert alert-light py-1">
                <small>Log in to make changes or see more details.</small>
            </div>
            <div class="text-center">
                <Button Class="btn-outline-danger" @onclick="NavigateToLoginWithReturnUrl">
                    Login
                </Button>
            </div>
        }
        else
        {
            <br />
            <div class="btn-row">
                <div class="left-buttons col-sm-6">
                    <NextPreviuosButtons CurrentDevice="CurrentDevice"
                                         DevicesListAsQueryable="_devicesListAsQueryable"
                                         CurrentDeviceChanged="HandleDeviceSwitch">
                    </NextPreviuosButtons>
                </div>
                <div class="right-buttons col-sm-6 text-end">
                    <ButtonSave ButtonEvent="Save" Form="refAddEditDeviceTest" IsButtonDisabled="@_saveDisabled" />
                    @if (_includeButtons)
                    {
                        <ButtonCloseCancel TextButton="Cancel" ButtonEvent="CancelForm" />
                    }
                </div>
            </div>
        }
    </EditForm>
}

<div>
    <SuccessModal @ref="_refSuccessModal" Title="Successful action!"></SuccessModal>
</div>

@code {
    [Parameter]
    public DeviceProfile? CurrentDevice { get; set; }

    [Parameter]
    public UserProfile? CurrentUser { get; set; }

    [Parameter]
    public EditForm refAddEditDeviceTest { get; set; } = new();

    [CascadingParameter]
    public CustomReusableModal? Parent { get; set; }

    [Parameter]
    public EventCallback DataChangedEvent { get; set; }

    public int RealEstateIdToAddDevice
    {
        get => selectedTargetRealEstateId;
        set => selectedTargetRealEstateId = value;
    }

    private int selectedTargetRealEstateId;
    private int _originalRealEstateId;
    private IQueryable<DeviceProfile>? _devicesListAsQueryable;
    private EditContext? editContext;
    private SuccessModal _refSuccessModal = default!;
    private string? errorMessage;
    private bool _includeButtons = false;
    private bool showErrorMessageVisible = false;
    private Array _deviceTypes = default!;
    private DeviceProfile? _previousDevice;

    private bool _isGuest => DataService.CurrentAppUser == null;
    private bool _saveDisabled => editContext == null || (!editContext.IsModified() && selectedTargetRealEstateId == _originalRealEstateId);

    protected override void OnInitialized()
    {
        // Cache the enum once to prevent repetitive reflection overhead on re-renders
        _deviceTypes = Enum.GetValues(typeof(DeviceType));

        if (CurrentDevice == null) return;

        editContext = new(CurrentDevice);
        _previousDevice = CurrentDevice;

        if (DataService.CurrentAppUser != null)
        {
            var allDevicesList = DataService.GetAllUserDevices();
            _devicesListAsQueryable = allDevicesList.AsQueryable();
        }
        else
        {
            _devicesListAsQueryable = new List<DeviceProfile> { CurrentDevice }.AsQueryable();
        }
    }

    protected override void OnParametersSet()
    {
        if (CurrentDevice == null) return;

        if (Parent != null)
        {
            _includeButtons = true;
        }

        // Only swap context if we actually navigated to a totally different device record
        if (CurrentDevice != _previousDevice)
        {
            editContext = new(CurrentDevice);
            _previousDevice = CurrentDevice;

            if (CurrentDevice.DeviceID == 0)
            {
                selectedTargetRealEstateId = 0;
            }
            else
            {
                selectedTargetRealEstateId = DataService.GetRealEstateByDeviceID(CurrentDevice.DeviceID);
            }
            _originalRealEstateId = selectedTargetRealEstateId;
        }

        base.OnParametersSet();
    }

    private void HandleDeviceSwitch(DeviceProfile targetDevice)
    {
        CurrentDevice = targetDevice;
        _previousDevice = targetDevice;
        editContext = new(CurrentDevice);

        if (CurrentDevice.DeviceID == 0)
        {
            selectedTargetRealEstateId = 0;
        }
        else
        {
            selectedTargetRealEstateId = DataService.GetRealEstateByDeviceID(CurrentDevice.DeviceID);
        }
        _originalRealEstateId = selectedTargetRealEstateId;
    }

    public async Task Save()
    {
        if (editContext != null)
        {
            await DeviceFormSubmitted(editContext);
        }
    }

    private async Task DeviceFormSubmitted(EditContext editContext)
    {
        if (!editContext.Validate()) return;

        bool isNewDevice = CurrentDevice!.DeviceID == 0;
        bool isCurrentlyAssigned = false;

        if (!isNewDevice)
        {
            isCurrentlyAssigned = DataService.GetRealEstateByDeviceID(CurrentDevice.DeviceID) > 0;
        }

        try
        {
            switch (isNewDevice, selectedTargetRealEstateId)
            {
                case (true, _):
                    DataService.AddNewDeviceToDataBase(CurrentDevice, selectedTargetRealEstateId);
                    break;

                case (false, 0) when isCurrentlyAssigned:
                    DataService.MoveDeviceToUnnassignedList(CurrentDevice);
                    break;

                case (false, var targetId) when !isCurrentlyAssigned && targetId != 0:
                    DataService.MoveDeviceFromUnassignedDevicesProfile(CurrentUser!, targetId, CurrentDevice);
                    break;

                case (false, var targetId) when targetId != 0:
                    DataService.MoveDeviceToOtherRealEstate(CurrentDevice.DeviceID, targetId);
                    break;

                default:
                    break;
            }

            await DataService.UpdateObjectInDB();
            await DataChangedEvent.InvokeAsync();
            StateHasChanged();

            selectedTargetRealEstateId = 0;
            _originalRealEstateId = 0;
            showErrorMessageVisible = false;
            editContext.MarkAsUnmodified();

            if (Parent != null)
            {
                await Parent.HideAsync();
            }
            else
            {
                await _refSuccessModal.OnShowModalClick();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Database error: " + ex.Message;
            showErrorMessageVisible = true;
        }
    }

    private void NavigateToLoginWithReturnUrl()
    {
        var currentUri = NavManager.ToBaseRelativePath(NavManager.Uri);
        var escapedReturnUrl = Uri.EscapeDataString(currentUri);
        NavManager.NavigateTo($"account/login?returnUrl={escapedReturnUrl}", forceLoad: true);
    }

    private void RealEstateIdToAddDeviceChanged()
    {
        showErrorMessageVisible = (selectedTargetRealEstateId == 0);
    }


    private async Task CancelForm()
    {
        if (Parent != null)
        {
            await Parent.HideAsync();
        }
    }
}