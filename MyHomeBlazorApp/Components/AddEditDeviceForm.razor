@using MyHomeBlazorApp.BlazorData
@using MyHome.Models;
@using MyHome;
@using MyHomeBlazorApp.Components.Modals
@using MyHomeBlazorApp.Pages
@using MyHomeBlazorApp.Shared
@using System.Reflection
@using MyHomeBlazorApp.Components
@inject BlazorData.DataService DataService
@inject IJSRuntime JSRuntime

<style>
    .form-select-custom {
        width: auto;
        min-width: 250px; /* Adjust this value to match your InputText width */
        max-width: 100%;
    }

    /* Button container to push Save to the right */
    .button-container {
        display: flex;
        justify-content: space-between; /* Spreads Prev/Next and Save apart */
        align-items: center;
        width: 100%;
        margin-top: 1rem;
    }

    .navigation-group {
        display: flex;
        gap: 10px; /* Space between Previous and Next */
    }

    /* Container for the whole form to keep it tidy */
    .edit-form-container {
        max-width: 500px; /* Adjust based on your modal size */
        margin: 0 auto;
    }

        /* Force all inputs and selects to have the same width */
        .edit-form-container .form-control,
        .edit-form-container .form-select {
            width: 100%;
            max-width: 350px; /* This matches your 'Name' and 'Producer' fields */
        }

    /* The Button Row Layout */
    .form-actions-row {
        display: flex;
        justify-content: space-between; /* Pushes Prev/Next left and Save right */
        align-items: center;
        width: 100%;
        max-width: 350px; /* Match the input width above */
        margin-top: 20px;
    }

    .nav-buttons {
        display: flex;
        gap: 10px; /* Space between Previuos and Next */
    }

    /* Fix for the Save Button component to ensure it aligns right */
    .save-wrapper {
        margin-left: auto;
    }
</style>

@if (showErrorMessageVisible)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
@if (CurrentDevice != null)
{
    <div class="edit-form-container">
        <EditForm @ref="refAddEditDeviceTest" EditContext="@editContext" id="refAddEditDeviceTest" OnSubmit="DeviceFormSubmitted" @oninput="OnInput">
            <DataAnnotationsValidator />
            <div class="form-group row mb-3">
                <label for="deviceName" class="col-sm-4 col-form-label">
                    Name
                </label>
                <div class="col-sm-8">
                    <InputText id="deviceName" @bind-Value="CurrentDevice.DeviceName" placeholder="Device Name" />
                </div>
                <ValidationMessage For=@(() => CurrentDevice.DeviceName) />
            </div>
            <div class="form-group row">
                <label for="deviceProduser" class="col-sm-4 col-form-label">
                    Produser
                </label>
                <div class="col-sm-8">
                    <InputText id="deviceProduser" @bind-Value="CurrentDevice.DeviceProduser" placeholder="Device Produser" />
                </div>
            </div>
            <div class="form-group row">
                <label for="deviceType" class="col-sm-4 col-form-label">Type</label>
                <div class="col-sm-8">
                    <InputSelect id="deviceType" @bind-Value="CurrentDevice.DeviceType" placeholder="Device Type">
                        @foreach (var type in Enum.GetValues(typeof(DeviceType)))
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <div class="form-group row">
                <label for="deviceSerialNumber" class="col-sm-4 col-form-label">
                    Serial Number
                </label>
                <div class="col-sm-8">
                    <InputText id="deviceSerialNumber" @bind-Value="CurrentDevice.DeviceSerialNumber" placeholder="Device Serial Number" />
                </div>
            </div>
            <div class="form-group row">
                <label for="deviceModelNumber" class="col-sm-4 col-form-label">
                    Model Number
                </label>
                <div class="col-sm-8">
                    <InputText id="deviceModelNumber" @bind-Value="CurrentDevice.DeviceModelNumber" placeholder="Device Model Number" />
                </div>
            </div>
            <div class="form-group row">
                <label for="deviceIpAddress" class="col-sm-4 col-form-label">
                    IP Address
                </label>
                <div class="col-sm-8">
                    <InputText id="deviceIpAddress" @bind-Value="CurrentDevice.IpAddress" placeholder="Device Ip Address" />
                </div>
            </div>
            <div class="form-group row">
                <label for="deviceMacAddress" class="col-sm-4 col-form-label">
                    Mac Address
                </label>
                <div class="col-sm-8">
                    <InputText id="deviceMacAddress" @bind-Value="CurrentDevice.MacAdrress" placeholder="Mac Address" />
                </div>
            </div>
            <div class="form-group row">
                <label for="deviceManualBookLink" class="col-sm-4 col-form-label">
                    Manual Link
                </label>
                <div class="col-sm-8">
                    <Button class="btn-sm btn btn-outline-info" @onclick="() => DataService.Navigate(CurrentDevice.DeviceID, JSRuntime)">Manual</Button>
                </div>
            </div>
            <div class="row">
                <div class="form-group">

                    <label class="form-label mt-3">Choose Real Estate:</label>
                    <InputSelect @bind-Value="selectedTargetRealEstateId" class="form-select-custom" @bind-Value:after="RealEsatateIdToAddDeviceChanged">
                        @if (CurrentUser.RealEstates == null || !CurrentUser.RealEstates.Any())
                        {
                            @* Option: User has NO real estate yet *@
                            <option value="0">No Real Estates found (Save as Unassigned)</option>
                        }
                        else
                        {
                            <option selected value="0">Select Real Estate...or Will Be Saved As Unnassigned</option>
                            @foreach (var realEstate in CurrentUser.RealEstates)
                            {
                                <option value="@realEstate.RealEstateID">@realEstate.RealEstateName</option>
                            }
                        }
                    </InputSelect>
                    @if (CurrentUser?.RealEstates == null || !CurrentUser.RealEstates.Any())
                    {
                        <small class="text-muted d-block mt-1">
                            Tip: You can move this to a Real Estate later.
                        </small>
                    }


                </div>
            </div>
            <div class="form-actions-row">
                <div class="nav-buttons">
                    @if (CurrentDevice.DeviceID != 0)
                    {
                        <NextPreviuosButtons @bind-CurrentDevice="@CurrentDevice"
                                             DevicesListAsQueryable="_devicesListAsQueryable">
                        </NextPreviuosButtons>
                    }
                    else if (_unassignedDevicesListAsQueryable.Count() > 1)
                    {
                        <NextPreviuosButtons @bind-CurrentDevice="@CurrentDevice"
                                             DevicesListAsQueryable="_unassignedDevicesListAsQueryable">
                        </NextPreviuosButtons>
                    }
                </div>
                @if (IncludeButtons)
                {

                    <div class="save-wrapper">
                        <AuthorizeView Context="auth">
                            <Authorized>
                                <ButtonSave Form="refAddEditDeviceTest"
                                            ButtonEvent="Save"
                                            IsButtonDisabled="@(!fieldHasBeenChanged)" />
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>
        </EditForm>
    </div>
}
<div>
    <SuccessModal @ref="_refSuccessModal" Title="Successful action!"></SuccessModal>
</div>


@code {

    [Parameter]
    public DeviceProfile CurrentDevice { get; set; } = new();
    [Parameter]
    public UserProfile CurrentUser { get; set; } = new();
    [Parameter]
    public EditForm refAddEditDeviceTest { get; set; } = new();
    [CascadingParameter]
    public CustomReusableModal? Parent { get; set; }
    [Parameter]
    public EventCallback DataChangedEvent { get; set; }
    [Parameter]
    public int RealEstateIdToAddDevice
    {
        get => selectedTargetRealEstateId;
        set
        {
            selectedTargetRealEstateId = value;
        }
    }
    private int selectedTargetRealEstateId;
    private IQueryable<DeviceProfile>? _devicesListAsQueryable { get; set; }
    private IQueryable<DeviceProfile>? _unassignedDevicesListAsQueryable { get; set; }
    private EditContext? editContext { get; set; }

    private SuccessModal _refSuccessModal = default!;
    private string? errorMessage;
    private bool chosedRealEstateIsValid;
    private bool IncludeButtons { get; set; } = true;
    private bool deviceIsAssignedToRealEstate;
    private bool validDeviceForm;
    private bool showErrorMessageVisible = false;
    private bool fieldHasBeenChanged { get; set; } = false;


    protected override async Task OnInitializedAsync()
    {
        await Init();
        base.OnInitialized();
    }

    private void OnInput()
    {
        fieldHasBeenChanged = true;
    }

    //todo: disable button if there is no changes in the editForm
    private async Task Init()
    {
        selectedTargetRealEstateId = DataService.GetRealEstateByDeviceID(CurrentDevice.DeviceID);
        editContext = new(CurrentDevice);
        var list = await DataService.GetUserWithUnassignedDevicesListAsync();
        _unassignedDevicesListAsQueryable = list.AsQueryable();
        _devicesListAsQueryable = DataService.CurrentUserWithAllData
        .RealEstates
        .SelectMany(realEstate => realEstate.DevicesProfiles)
        .OrderBy(d => DataService.GetRealEstateByDeviceID(d.DeviceID))
        .ThenBy(d => d.DeviceID).AsQueryable();
    }

    public async Task Save()
    {
        if (editContext != null)
        {
            await DeviceFormSubmitted(editContext);
        }
    }

    protected override void OnParametersSet()
    {
        if (Parent != null)
        {
            IncludeButtons = false;
        }

        if (CurrentDevice.DeviceID == 0)
        {
            selectedTargetRealEstateId = 0;
        }
        else
        {
            selectedTargetRealEstateId = DataService.GetRealEstateByDeviceID(CurrentDevice.DeviceID);
        }


        editContext = new(CurrentDevice);
        fieldHasBeenChanged = false;

        base.OnParametersSet();
    }

    private void RealEsatateIdToAddDeviceChanged()
    {
        fieldHasBeenChanged = true;
        showErrorMessageVisible = (selectedTargetRealEstateId == 0);
    }


    private async Task DeviceFormSubmitted(EditContext editContext)
    {
        // 1. Validate data annotations
        if (!editContext.Validate()) return;

        bool isNewDevice = CurrentDevice.DeviceID == 0;
        bool isCurrentlyAssigned = false;

        if (!isNewDevice)
        {
            // Check if the device is currently linked to a RealEstate
            isCurrentlyAssigned = DataService.GetRealEstateByDeviceID(CurrentDevice.DeviceID) > 0;
        }

        try
        {
            // 2. Decision Logic
            switch (isNewDevice, selectedTargetRealEstateId)
            {
                // Case 1: Add new device
                case (true, _):
                    await DataService.AddNewDeviceToDataBase(CurrentDevice, selectedTargetRealEstateId);
                    break;

                // Case 2: Existing device moved to "Unassigned" (Target ID 0)
                case (false, 0) when isCurrentlyAssigned:
                    await DataService.MoveDeviceToUnnassignedList(CurrentDevice);
                    break;

                // Case 3: Move from Unassigned list to a specific Real Estate
                case (false, var targetId) when !isCurrentlyAssigned && targetId != 0:
                    await DataService.MoveDeviceFromUnassignedDevicesProfile(CurrentUser, targetId, CurrentDevice);
                    break;

                // Case 4: Transfer from one Real Estate to another
                case (false, var targetId) when targetId != 0:
                    await DataService.MoveDeviceToOtherRealEstate(CurrentDevice.DeviceID, targetId);
                    break;

                default:
                    // Just update fields (Name, Serial Number, etc.) without changing location
                    await DataService.UpdateObjectInDB();
                    break;
            }

            // Finalize
            await DataService.UpdateObjectInDB();
            await DataChangedEvent.InvokeAsync();

            // Reset state
            selectedTargetRealEstateId = 0;
            showErrorMessageVisible = false;
            fieldHasBeenChanged = false;

            if (Parent != null)
            {
                await Parent.HideAsync();
            }
            else
            {
                await _refSuccessModal.OnShowModalClick();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Database error: " + ex.Message;
            showErrorMessageVisible = true;
        }
    }
}
